#!/bin/bash
# quetz-run — run a quetz simulation and get transcript + stats + pass/fail.
#
#   quetz-run [--board raptor] [--oracle JSON] [--deck PATH] [--firmware ELF]
#             [--stdin FILE] [--sensor FILE]
#             [--sink NAME] [--env K=V]... [--out DIR] [--timeout SEC]
#             [--bsp-discover] [--bsp-profile JSON] [--bsp-target raptor]
#             [--image NAME] [--allow-dirty] [--acceptance]
#             [--no-docker] [--quiet]
#
# With no arguments, runs the shipped ColdFire system demo (freestanding
# firmware: UART console + GPS NMEA replay + sensor stream + accelerator).
#
# Artifacts (in --out, default ./artifacts):
#   uart.txt        guest UART bytes only
#   events.jsonl    ordered host semantic events
#   sst.log         SST/QEMU diagnostics only
#   stats.csv       SST statistics (CSV, when flushed before completion)
#   result.txt      PASS / FAIL / ERROR + detail
#   result.json     structured oracle result
#   effective-run.json and workspace-provenance.json  exact run identity
#   <NAME>          QuetzSinkDevice capture (--sink NAME): bytes the guest
#                   pushed, for CI to diff against a golden file
#   bsp-mmio*.jsonl Raw/enriched BSP access trace (--bsp-discover)
#   bsp-report.txt  Likely BSP polls and write/readback mismatches
#   bsp-profile.generated.json  Inert observed-register profile skeleton
#
# Exit code contract (CI-ready):
#   0  host oracle reported PASS
#   2  host oracle reported FAIL
#   1  setup error, simulator error, or timeout
set -u

ORIGINAL_ARGS=("$@")

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Workspace root = parent of quetz-docker (host mode); in-container the tree
# is baked at /src.
if [ -d "${SCRIPT_DIR}/../sst-elements" ]; then
    WORKSPACE="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [ -d /workspace/boards ]; then
    WORKSPACE=/workspace
else
    WORKSPACE=""
fi
QUETZ_REL="src/sst/elements/quetz"

DECK=""
DECK_EXPLICIT=0
FIRMWARE=""
BOARD=""
BOARD_MANIFEST=""
ORACLE=""
ORACLE_ID="runner-setup"
ACCEPTANCE=0
ALLOW_DIRTY=0
WORKSPACE_MANIFEST=""
RUNTIME_IMAGE=""
RUNTIME_DIGEST=""
STDIN_FILE=""
SENSOR_FILE=""
SINK_NAME=""
OUT_DIR="./artifacts"
TIMEOUT_SEC=600
TIMEOUT_EXPLICIT=0
IMAGE="quetz-sim"
NO_DOCKER=0
QUIET=0
BSP_DISCOVER=0
BSP_PROFILE=""
BSP_TARGET="raptor"
UART_EVENT_PORT="uart0"
OUTPUT_INITIALIZED=0
declare -a EXTRA_ENV=()
PRESET_ENV_KEYS="QUETZ_MMIO_START QUETZ_MMIO_END QUETZ_RAM_START QUETZ_RAM_END QUETZ_UART_ADDR QUETZ_SENTINEL_ADDR"

usage() {
    sed -n '2,/^set -u$/p' "${BASH_SOURCE[0]}" \
        | sed -e '$d' -e 's/^# \{0,1\}//'
    print_banner
}

print_banner() {
    [ "${QUIET}" = 1 ] && return 0
    local banner="${SCRIPT_DIR}/BSP-HONESTY.txt"
    if [ -f "${banner}" ]; then
        cat "${banner}" >&2
    else
        echo "note: native QEMU treats unmodeled MCF5208 registers as RAZ/WI." >&2
        echo "Use --bsp-discover, then a hardware-reviewed --bsp-profile for" >&2
        echo "basic initialization correctness. See" >&2
        echo "sst-elements/${QUETZ_REL}/BSP-COMPATIBILITY.md" >&2
    fi
}

emit_setup_error() {
    local detail="$1"
    echo "quetz-run: ${detail}" >&2
    mkdir -p "${OUT_DIR}" 2>/dev/null || exit 1
    if [ "${OUTPUT_INITIALIZED}" = 0 ]; then
        : > "${OUT_DIR}/sst.log"
    fi
    echo "ERROR: ${detail}" > "${OUT_DIR}/result.txt"
    python3 "${SCRIPT_DIR}/quetz-result.py" \
        --output "${OUT_DIR}/result.json" --oracle-id "${ORACLE_ID}" --detail "${detail}" \
        >/dev/null 2>&1 || true
    exit 1
}

require_value() {
    if [ "$#" -lt 2 ] || [ -z "${2:-}" ] || [[ "${2}" == --* ]]; then
        emit_setup_error "$1 requires a value"
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        --board)     require_value "$@"; BOARD="$2"; shift 2 ;;
        --board-manifest) require_value "$@"; BOARD_MANIFEST="$2"; shift 2 ;;
        --oracle)    require_value "$@"; ORACLE="$2"; shift 2 ;;
        --deck)      require_value "$@"; DECK="$2"; DECK_EXPLICIT=1; shift 2 ;;
        --firmware)  require_value "$@"; FIRMWARE="$2"; shift 2 ;;
        --stdin)     require_value "$@"; STDIN_FILE="$2"; shift 2 ;;
        --sensor)    require_value "$@"; SENSOR_FILE="$2"; shift 2 ;;
        --sink)      require_value "$@"; SINK_NAME="$2"; shift 2 ;;
        --env)       require_value "$@"; EXTRA_ENV+=("$2"); shift 2 ;;
        --out)       require_value "$@"; OUT_DIR="$2"; shift 2 ;;
        --timeout)   require_value "$@"; TIMEOUT_SEC="$2"; TIMEOUT_EXPLICIT=1; shift 2 ;;
        --bsp-discover) BSP_DISCOVER=1; shift ;;
        --bsp-profile)  require_value "$@"; BSP_PROFILE="$2"; shift 2 ;;
        --bsp-target)   require_value "$@"; BSP_TARGET="$2"; shift 2 ;;
        --image)     require_value "$@"; IMAGE="$2"; shift 2 ;;
        --allow-dirty) ALLOW_DIRTY=1; shift ;;
        --acceptance) ACCEPTANCE=1; shift ;;
        --workspace-manifest) require_value "$@"; WORKSPACE_MANIFEST="$2"; shift 2 ;;
        --runtime-image) require_value "$@"; RUNTIME_IMAGE="$2"; shift 2 ;;
        --runtime-digest) require_value "$@"; RUNTIME_DIGEST="$2"; shift 2 ;;
        --no-docker) NO_DOCKER=1; shift ;;
        --quiet)     QUIET=1; shift ;;
        -h|--help)   usage; exit 0 ;;
        *) emit_setup_error "unknown argument '$1' (see --help)" ;;
    esac
done

print_banner

mkdir -p "${OUT_DIR}" || { echo "quetz-run: cannot create ${OUT_DIR}" >&2; exit 1; }
OUT_DIR="$(cd "${OUT_DIR}" && pwd)"
: > "${OUT_DIR}/sst.log"
for artifact in \
    "${OUT_DIR}/transcript.txt" "${OUT_DIR}/uart.txt" \
    "${OUT_DIR}/events.jsonl" "${OUT_DIR}/uart-events.jsonl" \
    "${OUT_DIR}/accelerator-events.jsonl" "${OUT_DIR}/stats.csv" \
    "${OUT_DIR}/result.txt" "${OUT_DIR}/result.json" \
    "${OUT_DIR}/effective-run.json" "${OUT_DIR}/workspace-provenance.json" \
    "${OUT_DIR}/build-packages.txt" "${OUT_DIR}/runtime-packages.txt"; do
    # Host mode stages this file into /out before re-entering the runner.
    [ -n "${WORKSPACE_MANIFEST}" ] && [ "${artifact}" = "${WORKSPACE_MANIFEST}" ] \
        || rm -f "${artifact}"
done
OUTPUT_INITIALIZED=1

fail_setup() {
    emit_setup_error "$1"
}

contract_root()
{
    local candidate
    for candidate in "${WORKSPACE}" /opt/quetz; do
        if [ -n "${candidate}" ] && [ -f "${candidate}/tools/validate_quetz_contract.py" ]; then
            echo "${candidate}"
            return 0
        fi
    done
    return 1
}

json_value()
{
    python3 -c 'import json,sys
value=json.load(open(sys.argv[1], encoding="utf-8"))
for part in sys.argv[2].split("."):
    value=value[int(part)] if isinstance(value, list) else value[part]
print(value)' "$1" "$2"
}

resolve_workspace_path()
{
    local relative="$1"
    case "${relative}" in
        sst-elements/*)
            if [ -d /src/sst-elements ]; then
                echo "/src/sst-elements/${relative#sst-elements/}"
            else
                echo "${WORKSPACE}/${relative}"
            fi ;;
        *) echo "${WORKSPACE}/${relative}" ;;
    esac
}

configure_board()
{
    [ -n "${BOARD}" ] || return 0
    [ "${BOARD}" = raptor ] || fail_setup "unknown board preset: ${BOARD}"
    [ -n "${WORKSPACE}" ] || fail_setup "workspace is required for --board raptor"
    [ -n "${BOARD_MANIFEST}" ] || BOARD_MANIFEST="${WORKSPACE}/boards/raptor/board.json"
    [ -f "${BOARD_MANIFEST}" ] || fail_setup "board manifest not found: ${BOARD_MANIFEST}"
    [ -n "${ORACLE}" ] || fail_setup "--board raptor requires --oracle"
    [ -f "${ORACLE}" ] || fail_setup "oracle not found: ${ORACLE}"
    [ -n "${FIRMWARE}" ] || fail_setup "--board raptor requires --firmware"
    [ -f "${FIRMWARE}" ] || fail_setup "firmware not found: ${FIRMWARE}"

    local root
    root="$(contract_root)" || fail_setup "Quetz contract tools not found"
    if [ "${ACCEPTANCE}" = 1 ]; then
        local canonical_board canonical_oracle candidate
        canonical_board="${WORKSPACE}/boards/raptor/board.json"
        [ -f "${canonical_board}" ] && cmp -s "${BOARD_MANIFEST}" "${canonical_board}" \
            || fail_setup "Raptor acceptance requires the checked-in board contract"
        canonical_oracle=""
        for candidate in "${WORKSPACE}"/tests/raptor/*.json; do
            if [ -f "${candidate}" ] && cmp -s "${ORACLE}" "${candidate}"; then
                canonical_oracle="${candidate}"
                break
            fi
        done
        [ -n "${canonical_oracle}" ] \
            || fail_setup "Raptor acceptance requires a checked-in oracle"
    fi
    python3 "${root}/tools/validate_raptor_board.py" "${BOARD_MANIFEST}" --quiet \
        || fail_setup "board manifest validation failed"
    python3 "${root}/tools/validate_quetz_contract.py" oracle "${ORACLE}" \
        --board "${BOARD_MANIFEST}" >/dev/null \
        || fail_setup "oracle validation failed"
    local oracle_timeout
    oracle_timeout="$(json_value "${ORACLE}" timeout_seconds)"
    if [ "${TIMEOUT_EXPLICIT}" = 0 ]; then
        TIMEOUT_SEC="${oracle_timeout}"
    elif [ "${ACCEPTANCE}" = 1 ] && [ "${TIMEOUT_SEC}" != "${oracle_timeout}" ]; then
        fail_setup "Raptor acceptance requires oracle timeout ${oracle_timeout}"
    fi

    ORACLE_ID="$(json_value "${ORACLE}" id)"
    local preset_index preset_id preset_class oracle_class
    preset_index="$(python3 -c 'import json,sys
b=json.load(open(sys.argv[1], encoding="utf-8"))
matches=[i for i,p in enumerate(b["runner_presets"]) if sys.argv[2] in p["allowed_oracles"]]
if len(matches) != 1: raise SystemExit(1)
print(matches[0])' "${BOARD_MANIFEST}" "${ORACLE_ID}")" \
        || fail_setup "oracle ${ORACLE_ID} must select exactly one Raptor preset"
    preset_id="$(json_value "${BOARD_MANIFEST}" "runner_presets.${preset_index}.id")"
    preset_class="$(json_value "${BOARD_MANIFEST}" "runner_presets.${preset_index}.classification")"
    oracle_class="$(json_value "${ORACLE}" classification)"
    [ "${oracle_class}" = "${preset_class}" ] \
        || fail_setup "oracle classification ${oracle_class} does not match preset ${preset_class}"
    if [ "${ACCEPTANCE}" = 1 ] && [ "${preset_class}" != acceptance ]; then
        fail_setup "Raptor acceptance mode rejects legacy-diagnostic preset ${preset_id}"
    fi
    if [ "${ACCEPTANCE}" = 1 ]; then
        [ "${ALLOW_DIRTY}" = 0 ] \
            || fail_setup "Raptor acceptance requires strict workspace provenance"
        [ "${DECK_EXPLICIT}" = 0 ] \
            || fail_setup "Raptor acceptance rejects deck overrides"
        [ "${BSP_DISCOVER}" = 0 ] \
            || fail_setup "Raptor acceptance rejects BSP discovery mode"
        [ "${#EXTRA_ENV[@]}" = 0 ] \
            || fail_setup "Raptor acceptance rejects environment overrides"
    fi

    PRESET_ENV_KEYS="$(python3 -c 'import json,sys
b=json.load(open(sys.argv[1], encoding="utf-8"))
print(" ".join(sorted(b["runner_presets"][int(sys.argv[2])]["environment"])))' \
        "${BOARD_MANIFEST}" "${preset_index}")"

    local kv key
    for kv in ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"}; do
        case "${kv}" in *=*) ;; *) fail_setup "--env requires KEY=VALUE: ${kv}" ;; esac
        key="${kv%%=*}"
        case "${key}" in
            QUETZ_MMIO_PAYLOAD|QUETZ_MMIO_START|QUETZ_MMIO_END|QUETZ_RAM_START|QUETZ_RAM_END|QUETZ_UART_ADDR|QUETZ_SENTINEL_ADDR|QUETZ_SST_WIN_START|QUETZ_SST_WIN_END)
                fail_setup "--board raptor rejects geometry override ${key}" ;;
        esac
    done

    local geometry_key geometry_value
    for geometry_key in QUETZ_MMIO_PAYLOAD QUETZ_MMIO_START QUETZ_MMIO_END \
        QUETZ_RAM_START QUETZ_RAM_END QUETZ_UART_ADDR QUETZ_SENTINEL_ADDR \
        QUETZ_SST_WIN_START QUETZ_SST_WIN_END; do
        if env | grep -q "^${geometry_key}="; then
            fail_setup "--board raptor rejects inherited geometry ${geometry_key}"
        fi
    done
    for geometry_key in ${PRESET_ENV_KEYS}; do
        geometry_value="$(python3 -c 'import json,sys
b=json.load(open(sys.argv[1], encoding="utf-8")); print(b["runner_presets"][int(sys.argv[2])]["environment"][sys.argv[3]])' "${BOARD_MANIFEST}" "${preset_index}" "${geometry_key}")"
        export "${geometry_key}=${geometry_value}"
    done
    [ -n "${DECK}" ] \
        || DECK="$(resolve_workspace_path "$(json_value "${BOARD_MANIFEST}" "runner_presets.${preset_index}.deck")")"
    local preset_profile
    preset_profile="$(python3 -c 'import json,sys
b=json.load(open(sys.argv[1], encoding="utf-8")); v=b["runner_presets"][int(sys.argv[2])]["profile"]; print(v or "")' "${BOARD_MANIFEST}" "${preset_index}")"
    if [ -z "${BSP_PROFILE}" ] && [ -n "${preset_profile}" ]; then
        BSP_PROFILE="$(resolve_workspace_path "${preset_profile}")"
    fi
    if [ "${preset_class}" = acceptance ] && [ -n "${BSP_PROFILE}" ]; then
        fail_setup "Raptor acceptance preset ${preset_id} rejects compatibility profiles"
    fi
    [ -f "${DECK}" ] || fail_setup "deck not found: ${DECK}"
    if [ -n "${BSP_PROFILE}" ]; then
        [ -f "${BSP_PROFILE}" ] || fail_setup "board profile not found: ${BSP_PROFILE}"
    fi
    [ -n "${STDIN_FILE}" ] || STDIN_FILE="$(dirname "${DECK}")/data/gps_nmea.txt"
    [ -n "${SENSOR_FILE}" ] || SENSOR_FILE="$(dirname "${DECK}")/data/sensor_stream.bin"
    [ -f "${STDIN_FILE}" ] || fail_setup "UART input fixture not found: ${STDIN_FILE}"
    [ -f "${SENSOR_FILE}" ] || fail_setup "sensor fixture not found: ${SENSOR_FILE}"
}

configure_board

if [ "${ACCEPTANCE}" = 1 ] \
    && { [ "${NO_DOCKER}" = 1 ] || [ -f /.dockerenv ]; }; then
    [ -f /.dockerenv ] && [ "${SCRIPT_DIR}" = /quetz-docker ] \
        && [ "${WORKSPACE}" = /workspace ] \
        || fail_setup "Raptor acceptance requires the container-managed runtime"
fi

# ---------------------------------------------------------------------------
# In-container (or --no-docker) execution: run sst directly.
# ---------------------------------------------------------------------------
if [ "${NO_DOCKER}" = 1 ] || [ -f /.dockerenv ]; then
    if [ "${ACCEPTANCE}" = 1 ]; then
        # Canonical deck/runtime inputs come from the preset and runtime image,
        # never an inherited shell environment.
        unset QUETZ_QEMU QUETZ_PLUGIN QUETZ_LOADER QUETZ_BSP_PROFILE \
            QUETZ_BSP_DISCOVER QUETZ_EXE \
            QUETZ_ACCELERATOR_EVENTS_FILE QUETZ_CLOCK
    fi
    ELEM_DIR=""
    for c in "/src/sst-elements/${QUETZ_REL}" "${WORKSPACE}/sst-elements/${QUETZ_REL}"; do
        [ -n "${c}" ] && [ -d "${c}" ] && ELEM_DIR="${c}" && break
    done
    [ -n "${ELEM_DIR}" ] || fail_setup "quetz element tree not found"

    [ -n "${DECK}" ] || DECK="${ELEM_DIR}/tests/sysmode/basic_quetz_coldfire_system.py"
    [ -f "${DECK}" ] || fail_setup "deck not found: ${DECK}"

    export QUETZ_MMIO_PAYLOAD="${QUETZ_MMIO_PAYLOAD:-1}"
    export QUETZ_MMIO_START="${QUETZ_MMIO_START:-0x70000000}"
    export QUETZ_MMIO_END="${QUETZ_MMIO_END:-0x7001FFFF}"
    export QUETZ_STDOUT_FILE="${OUT_DIR}/uart.txt"
    export QUETZ_STATS_OUT="${OUT_DIR}/stats.csv"
    # Accelerator-capable decks may pass this path to a durable model event
    # producer. Any resulting stream is validated and merged below before it
    # can influence an oracle.
    export QUETZ_ACCELERATOR_EVENTS_FILE="${OUT_DIR}/accelerator-events.jsonl"
    [ -n "${FIRMWARE}" ]    && export QUETZ_EXE="${FIRMWARE}"
    [ -n "${STDIN_FILE}" ]  && export QUETZ_STDIN_FILE="${STDIN_FILE}"
    [ -n "${SENSOR_FILE}" ] && export QUETZ_SENSOR_FILE="${SENSOR_FILE}"
    # Sink capture is an artifact by construction: the device writes it
    # directly into the artifacts dir.
    [ -n "${SINK_NAME}" ]   && export QUETZ_SINK_FILE="${OUT_DIR}/$(basename "${SINK_NAME}")"
    if [ "${BSP_DISCOVER}" = 1 ]; then
        export QUETZ_BSP_DISCOVER=1
        export QUETZ_BSP_LOG="${OUT_DIR}/bsp-mmio.raw.jsonl"
    fi
    if [ -n "${BSP_PROFILE}" ]; then
        [ -f "${BSP_PROFILE}" ] || fail_setup "--bsp-profile file not found: ${BSP_PROFILE}"
        export QUETZ_BSP_PROFILE="${BSP_PROFILE}"
    fi
    if [ "${BSP_DISCOVER}" = 1 ] || [ -n "${BSP_PROFILE}" ]; then
        export QUETZ_BSP_TARGET="${BSP_TARGET}"
    fi
    for kv in ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"}; do export "${kv?}"; done

    if [ -n "${BOARD}" ]; then
        case "${QUETZ_UART_ADDR}" in
            0xfc060000|0xFC060000) UART_EVENT_PORT="uart0" ;;
            0xfc064000|0xFC064000) UART_EVENT_PORT="uart1" ;;
            0xfc068000|0xFC068000) UART_EVENT_PORT="uart2" ;;
            *) fail_setup "unsupported Raptor console UART address ${QUETZ_UART_ADDR}" ;;
        esac
    fi

    command -v sst >/dev/null || fail_setup "sst not on PATH (use the quetz-sim image, or omit --no-docker)"

    if [ -n "${BOARD}" ]; then
        [ -n "${WORKSPACE_MANIFEST}" ] && [ -f "${WORKSPACE_MANIFEST}" ] \
            || fail_setup "Raptor run requires workspace provenance"
        if [ "${ACCEPTANCE}" = 1 ] && \
                [ "$(json_value "${WORKSPACE_MANIFEST}" mode)" != strict ]; then
            fail_setup "Raptor acceptance requires strict workspace provenance"
        fi
        [ -n "${RUNTIME_IMAGE}" ] || fail_setup "Raptor run requires runtime image identity"
        [ -n "${RUNTIME_DIGEST}" ] || fail_setup "Raptor run requires runtime image digest"
        ROOT="$(contract_root)" || fail_setup "Quetz contract tools not found"
        QEMU_VERSION="$(qemu-system-m68k --version 2>/dev/null || true)"
        QEMU_VERSION="${QEMU_VERSION%%$'\n'*}"
        SST_VERSION="$(sst --version 2>/dev/null || true)"
        SST_VERSION="${SST_VERSION%%$'\n'*}"
        QUETZ_VERSION="$(python3 -c 'import json,sys
m=json.load(open(sys.argv[1], encoding="utf-8"))
print(next((s["head"] for s in m["submodules"] if s["path"] == "sst-elements"), "unknown"))' "${WORKSPACE_MANIFEST}")"
        MANIFEST_ARGS=(
            --run-id "${ORACLE_ID}-run"
            --board "${BOARD_MANIFEST}"
            --firmware "${FIRMWARE}"
            --oracle "${ORACLE}"
            --workspace-manifest "${WORKSPACE_MANIFEST}"
            --image "${RUNTIME_IMAGE}"
            --image-digest "${RUNTIME_DIGEST}"
            --qemu "${QEMU_VERSION:-unknown}"
            --sst "${SST_VERSION:-unknown}"
            --quetz "${QUETZ_VERSION}"
            --output "${OUT_DIR}/effective-run.json"
        )
        for argument in "${ORIGINAL_ARGS[@]}"; do
            MANIFEST_ARGS+=("--command-arg=${argument}")
        done
        for geometry_key in ${PRESET_ENV_KEYS}; do
            MANIFEST_ARGS+=("--environment=${geometry_key}=${!geometry_key}")
        done
        for package_snapshot in build-packages runtime-packages; do
            if [ -f "/opt/quetz/${package_snapshot}.txt" ]; then
                cp -f "/opt/quetz/${package_snapshot}.txt" \
                    "${OUT_DIR}/${package_snapshot}.txt"
                MANIFEST_ARGS+=(
                    "--input=${package_snapshot}=${OUT_DIR}/${package_snapshot}.txt"
                )
            fi
        done
        MANIFEST_ARGS+=(
            "--input=deck=${DECK}"
            "--input=uart-input=${STDIN_FILE}"
            "--input=sensor-input=${SENSOR_FILE}"
            "--environment=QUETZ_BSP_TARGET=${BSP_TARGET}"
        )
        if [ -n "${BSP_PROFILE}" ]; then
            MANIFEST_ARGS+=(
                "--input=profile=${BSP_PROFILE}"
                "--environment=QUETZ_BSP_PROFILE=${BSP_PROFILE}"
            )
        fi
        python3 "${ROOT}/tools/create_quetz_run_manifest.py" "${MANIFEST_ARGS[@]}" \
            >> "${OUT_DIR}/sst.log" 2>&1 \
            || fail_setup "effective run manifest creation failed"
    fi

    cd "${OUT_DIR}"
    START_SECONDS="$(date +%s)"
    if [ -n "${BOARD}" ] \
        && [ "$(json_value "${ORACLE}" firmware.production)" = True ]; then
        # Production firmware cannot be modified to write a test sentinel and
        # often has no guest exit path. Supervise its UART completion matcher
        # live, stop the complete SST/QEMU process group, then let the normal
        # host oracle evaluation below classify PASS versus FAIL.
        python3 "${ROOT}/tools/run_until_uart_completion.py" \
            --oracle "${ORACLE}" \
            --uart "${OUT_DIR}/uart.txt" \
            --port "${UART_EVENT_PORT}" \
            --timeout "${TIMEOUT_SEC}" \
            -- sst "${DECK}" >> "${OUT_DIR}/sst.log" 2>&1
    elif command -v timeout >/dev/null; then
        # Preserve the legacy diagnostic path: guest TestFinisher/simulator
        # completion remains authoritative for non-production firmware.
        timeout "${TIMEOUT_SEC}" sst "${DECK}" >> "${OUT_DIR}/sst.log" 2>&1
    else
        sst "${DECK}" >> "${OUT_DIR}/sst.log" 2>&1   # no coreutils timeout (macOS)
    fi
    SST_RC=$?
    END_SECONDS="$(date +%s)"
    DURATION_MS="$(( (END_SECONDS - START_SECONDS) * 1000 ))"
    # Host-defined completion can stop SST before its CSV backend flushes.
    # Do not publish a zero-byte file as a statistics artifact.
    [ -s "${OUT_DIR}/stats.csv" ] || rm -f "${OUT_DIR}/stats.csv"

    if [ -f "${OUT_DIR}/uart.txt" ]; then
        cp -f "${OUT_DIR}/uart.txt" "${OUT_DIR}/transcript.txt"
    fi

    # Discovery is postprocessed even when the guest times out: a stuck BSP is
    # the expected first run, and its final repeated read is the useful result.
    if [ "${BSP_DISCOVER}" = 1 ] && [ -f "${OUT_DIR}/bsp-mmio.raw.jsonl" ]; then
        declare -a BSP_TOOL_ARGS=(
            --input "${OUT_DIR}/bsp-mmio.raw.jsonl"
            --trace-out "${OUT_DIR}/bsp-mmio.jsonl"
            --report-out "${OUT_DIR}/bsp-report.txt"
            --profile-out "${OUT_DIR}/bsp-profile.generated.json"
        )
        [ -n "${FIRMWARE}" ] && BSP_TOOL_ARGS+=(--elf "${FIRMWARE}")
        if ! python3 "${ELEM_DIR}/tools/bsp_profile.py" "${BSP_TOOL_ARGS[@]}" \
                >> "${OUT_DIR}/sst.log" 2>&1; then
            echo "WARN: BSP discovery postprocessing failed; raw log retained" \
                >> "${OUT_DIR}/sst.log"
        fi
    fi

    if [ -n "${BOARD}" ]; then
        [ "${SST_RC}" = 0 ] || fail_setup "simulator exited ${SST_RC}"
        [ -s "${OUT_DIR}/uart.txt" ] || fail_setup "guest UART artifact is missing or empty"
        if grep -Eiq \
                'RAPTOR_MMIO_UNSUPPORTED|fatal|profile[^[:alnum:]]+error|traceback' \
                "${OUT_DIR}/sst.log"; then
            fail_setup "strict-MMIO, fatal simulator, or profile diagnostic observed"
        fi
        python3 "${ROOT}/tools/validate_quetz_contract.py" uart-event \
            --transcript "${OUT_DIR}/uart.txt" --output "${OUT_DIR}/uart-events.jsonl" \
            --port "${UART_EVENT_PORT}" \
            >> "${OUT_DIR}/sst.log" 2>&1 \
            || fail_setup "UART event generation failed"
        EVENT_INPUTS=(--input "${OUT_DIR}/uart-events.jsonl")
        if [ -e "${OUT_DIR}/accelerator-events.jsonl" ]; then
            python3 "${ROOT}/tools/validate_quetz_contract.py" \
                accelerator-event-stream "${OUT_DIR}/accelerator-events.jsonl" \
                >> "${OUT_DIR}/sst.log" 2>&1 \
                || fail_setup "accelerator event stream validation failed"
            EVENT_INPUTS+=(--input "${OUT_DIR}/accelerator-events.jsonl")
        fi
        python3 "${ROOT}/tools/validate_quetz_contract.py" merge-events \
            "${EVENT_INPUTS[@]}" --output "${OUT_DIR}/events.jsonl" \
            >> "${OUT_DIR}/sst.log" 2>&1 \
            || fail_setup "event stream merge failed"
        rm -f "${OUT_DIR}/uart-events.jsonl"
        EVALUATE_ARGS=(
            --oracle "${ORACLE}"
            --events "${OUT_DIR}/events.jsonl"
            --duration-ms "${DURATION_MS}"
            --board "${BOARD_MANIFEST}"
            --run-manifest "${OUT_DIR}/effective-run.json"
            --workspace-manifest "${WORKSPACE_MANIFEST}"
            --artifact "uart=${OUT_DIR}/uart.txt=text/plain"
            --artifact "events=${OUT_DIR}/events.jsonl=application/x-ndjson"
            --artifact "sst-log=${OUT_DIR}/sst.log=text/plain"
            --artifact "effective-run=${OUT_DIR}/effective-run.json=application/json"
            --artifact "workspace-provenance=${WORKSPACE_MANIFEST}=application/json"
            --output "${OUT_DIR}/result.json"
        )
        [ -f "${OUT_DIR}/stats.csv" ] \
            && EVALUATE_ARGS+=(--artifact "stats=${OUT_DIR}/stats.csv=text/csv")
        [ -f "${OUT_DIR}/accelerator-events.jsonl" ] \
            && EVALUATE_ARGS+=(
                --artifact "accelerator-events=${OUT_DIR}/accelerator-events.jsonl=application/x-ndjson"
            )
        for package_snapshot in build-packages runtime-packages; do
            [ -f "${OUT_DIR}/${package_snapshot}.txt" ] \
                && EVALUATE_ARGS+=(
                    --artifact "${package_snapshot}=${OUT_DIR}/${package_snapshot}.txt=text/plain"
                )
        done
        if ! EVALUATION_OUTPUT="$(python3 "${ROOT}/tools/validate_quetz_contract.py" \
                evaluate "${EVALUATE_ARGS[@]}" 2>&1)"; then
            echo "${EVALUATION_OUTPUT}" >> "${OUT_DIR}/sst.log"
            fail_setup "oracle evaluation failed"
        fi
        RESULT="$(json_value "${OUT_DIR}/result.json" outcome)"
        DETAIL="$(json_value "${OUT_DIR}/result.json" completion.detail)"
        if [ "${RESULT}" = PASS ]; then
            RC=0
        else
            RC=2
        fi
        echo "${RESULT}: ${DETAIL}" > "${OUT_DIR}/result.txt"
        [ "${QUIET}" = 1 ] || echo "quetz-run: ${RESULT} — artifacts in ${OUT_DIR}" >&2
        exit "${RC}"
    fi

    RESULT="ERROR" ; RC=1 ; DETAIL="no TestFinisher sentinel in output (sst exit ${SST_RC})"
    if grep -q "TESTFINISH\[[0-9]*\].*(PASS)" "${OUT_DIR}/sst.log"; then
        RESULT="PASS"; RC=0; DETAIL="guest sentinel reported PASS"
    elif grep -q "TESTFINISH\[[0-9]*\].*(FAIL)" "${OUT_DIR}/sst.log"; then
        RESULT="FAIL"; RC=2; DETAIL="guest sentinel reported FAIL"
    elif [ "${SST_RC}" = 124 ]; then
        DETAIL="timeout after ${TIMEOUT_SEC}s"
    fi
    echo "${RESULT}: ${DETAIL}" > "${OUT_DIR}/result.txt"
    [ "${QUIET}" = 1 ] || echo "quetz-run: ${RESULT} — artifacts in ${OUT_DIR}" >&2
    exit "${RC}"
fi

# ---------------------------------------------------------------------------
# Host mode: stage inputs, re-invoke inside the container.
# ---------------------------------------------------------------------------
command -v docker >/dev/null || fail_setup "docker not found (or use --no-docker on a host with sst installed)"
[ -n "${WORKSPACE}" ] || fail_setup "workspace not found (run from the raptor-balar checkout)"

docker image inspect "${IMAGE}" >/dev/null 2>&1 \
    || fail_setup "image '${IMAGE}' not found — build the explicitly requested image"
RUNTIME_IMAGE="${IMAGE}"
RUNTIME_DIGEST="$(docker image inspect "${IMAGE}" --format '{{.Id}}')"

if [ -n "${BOARD}" ]; then
    ROOT="$(contract_root)" || fail_setup "Quetz contract tools not found"
    PROVENANCE_ARGS=(--workspace "${WORKSPACE}" --output "${OUT_DIR}/workspace-provenance.json")
    if [ "${ALLOW_DIRTY}" = 1 ]; then
        PROVENANCE_ARGS+=(--mode development --allow-dirty)
    else
        PROVENANCE_ARGS+=(--mode strict)
    fi
    python3 "${ROOT}/tools/quetz_provenance.py" "${PROVENANCE_ARGS[@]}" \
        || fail_setup "workspace identity check failed"
    WORKSPACE_MANIFEST="${OUT_DIR}/workspace-provenance.json"
    if [ "${ACCEPTANCE}" = 1 ]; then
        IMAGE_LABELS="$(docker image inspect "${IMAGE}" --format '{{json .Config.Labels}}')" \
            || fail_setup "cannot read runtime image source labels"
        python3 -c 'import json,sys
m=json.load(open(sys.argv[1], encoding="utf-8"))
labels=json.loads(sys.argv[2]) or {}
submodules={item["path"]: item["head"] for item in m["submodules"]}
expected={
    "org.quetz.workspace.revision": m["workspace"]["commit"],
    "org.quetz.submodule.quetz-docker": submodules["quetz-docker"],
    "org.quetz.submodule.sst-core": submodules["sst-core"],
    "org.quetz.submodule.sst-elements": submodules["sst-elements"],
}
mismatches=[f"{key}: image={labels.get(key)!r}, workspace={value!r}"
            for key,value in expected.items() if labels.get(key) != value]
if mismatches:
    print("runtime image source mismatch: " + "; ".join(mismatches), file=sys.stderr)
    raise SystemExit(1)' "${WORKSPACE_MANIFEST}" "${IMAGE_LABELS}" \
            || fail_setup "runtime image does not match strict workspace provenance"
    fi
fi

mkdir -p "${OUT_DIR}/inputs"
declare -a RUN_ARGS=(--quiet --no-docker --out /out --timeout "${TIMEOUT_SEC}")
[ "${BSP_DISCOVER}" = 1 ] && RUN_ARGS+=(--bsp-discover)
RUN_ARGS+=(--bsp-target "${BSP_TARGET}")

stage_file() {  # $1 host path, $2 flag name -> echoes container path
    local host="$1"
    [ -f "${host}" ] || fail_setup "$2 file not found: ${host}"
    cp -f "${host}" "${OUT_DIR}/inputs/$(basename "${host}")"
    echo "/out/inputs/$(basename "${host}")"
}

if [ -n "${DECK}" ] && [ "${DECK_EXPLICIT}" = 1 ]; then
    [ -f "${DECK}" ] || fail_setup "deck not found: ${DECK}"
    case "$(cd "$(dirname "${DECK}")" && pwd)/" in
        "${WORKSPACE}/sst-elements/"*)
            # Deck inside the tree: translate to the container mount so its
            # relative imports (quetz_test_helpers) keep working.
            REL="$(python3 -c "import os,sys;print(os.path.relpath(sys.argv[1],sys.argv[2]))" "${DECK}" "${WORKSPACE}/sst-elements")"
            RUN_ARGS+=(--deck "/src/sst-elements/${REL}") ;;
        *)
            RUN_ARGS+=(--deck "$(stage_file "${DECK}" --deck)") ;;
    esac
fi
if [ -n "${BOARD}" ]; then
    RUN_ARGS+=(
        --board "${BOARD}"
        --board-manifest "$(stage_file "${BOARD_MANIFEST}" --board-manifest)"
        --oracle "$(stage_file "${ORACLE}" --oracle)"
        --workspace-manifest /out/workspace-provenance.json
        --runtime-image "${RUNTIME_IMAGE}"
        --runtime-digest "${RUNTIME_DIGEST}"
    )
    [ "${ACCEPTANCE}" = 1 ] && RUN_ARGS+=(--acceptance)
fi
[ -n "${FIRMWARE}" ] && RUN_ARGS+=(--firmware "$(stage_file "${FIRMWARE}" --firmware)")
[ -n "${STDIN_FILE}" ]  && RUN_ARGS+=(--stdin  "$(stage_file "${STDIN_FILE}" --stdin)")
[ -n "${SENSOR_FILE}" ] && RUN_ARGS+=(--sensor "$(stage_file "${SENSOR_FILE}" --sensor)")
[ -n "${SINK_NAME}" ]   && RUN_ARGS+=(--sink "$(basename "${SINK_NAME}")")
[ -n "${BSP_PROFILE}" ] && RUN_ARGS+=(--bsp-profile "$(stage_file "${BSP_PROFILE}" --bsp-profile)")
for kv in ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"}; do RUN_ARGS+=(--env "${kv}"); done

docker run --rm \
    -v "${WORKSPACE}/sst-elements:/src/sst-elements:ro" \
    -v "${WORKSPACE}:/workspace:ro" \
    -v "${OUT_DIR}:/out" \
    -v "${SCRIPT_DIR}:/quetz-docker:ro" \
    "${IMAGE}" \
    bash /quetz-docker/quetz-run "${RUN_ARGS[@]}"
RC=$?
[ -f "${OUT_DIR}/result.json" ] \
    || fail_setup "container execution failed (docker exit ${RC})"
[ "${QUIET}" = 1 ] || { [ -f "${OUT_DIR}/result.txt" ] && echo "quetz-run: $(cat "${OUT_DIR}/result.txt") — artifacts in ${OUT_DIR}" >&2; }
exit "${RC}"
